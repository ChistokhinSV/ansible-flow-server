# Settings of Ansible Flow Server. Copy to .env (which is not in git) and change what you need;
# every line is optional. The environment wins over this file. AFS_ENV_FILE names another file.

# The address and port to listen on. 127.0.0.1 answers on this machine only; 0.0.0.0 on all
# interfaces. The server speaks HTTPS; the port is 8443 unless set.
AFS_HOST=127.0.0.1
AFS_PORT=8443

# The address people open. The certificate must be good for its host, and redirects go to it.
#AFS_PUBLIC_URL=https://flows.example.net

# A port that answers plain HTTP with a redirect to HTTPS. Unset: plain HTTP is not answered.
#AFS_HTTP_PORT=8080

# Behind a proxy that does HTTPS itself: plain HTTP (port 8080 unless set), and the proxies whose
# word is taken for who asked.
#AFS_TLS=off
#AFS_TRUSTED_PROXIES=127.0.0.1

# Certificate authorities of your own network, for what the server connects to (PEM).
#AFS_CA_FILE=/etc/flow-server/internal-ca.pem

# Allow a project's repository to be a folder of this machine (a single-machine install, tests).
#AFS_GIT_LOCAL=on

# Where the server keeps what it owns (the SQLite database; later repositories and runs).
AFS_DATA_DIR=data

# The database. Default: SQLite, the file afs.db in the data folder.
#   sqlite:flows.db                                      a file in the data folder
#   sqlite:/var/lib/flow-server/afs.db                   a file anywhere
#   postgres://flows:CHANGE_ME@db.example.net:5432/flows PostgreSQL
#AFS_DATABASE_URL=sqlite:afs.db

# The log: trace, debug, info, warn, error, fatal or silent; as text or json (one object a line).
AFS_LOG_LEVEL=info
AFS_LOG_FORMAT=text
