# Settings of Ansible Flow Server. Copy to .env (which is not in git) and change what you need;
# every line is optional. The environment wins over this file. AFS_ENV_FILE names another file.

# The address and port to listen on. 127.0.0.1 answers on this machine only; 0.0.0.0 on all
# interfaces. The server speaks HTTPS; the port is 8443 unless set.
AFS_HOST=127.0.0.1
AFS_PORT=8443

# The address people open. The certificate must be good for its host, and redirects go to it.
#AFS_PUBLIC_URL=https://flows.example.net

# A port that answers plain HTTP with a redirect to HTTPS. Unset: plain HTTP is not answered.
#AFS_HTTP_PORT=8080

# Behind a proxy that does HTTPS itself: plain HTTP (port 8080 unless set), and the proxies whose
# word is taken for who asked.
#AFS_TLS=off
#AFS_TRUSTED_PROXIES=127.0.0.1

# Certificate authorities of your own network, for what the server connects to (PEM).
#AFS_CA_FILE=/etc/flow-server/internal-ca.pem

# The master key: what stored credentials are encrypted with. Unset: the server makes one in
# <data folder>/master.key at first start. Keep a copy somewhere safe: without it the stored
# credentials cannot be read. Make one with: openssl rand -base64 32
#AFS_MASTER_KEY_FILE=/etc/flow-server/master.key
#AFS_MASTER_KEY=

# The container engine runs use: auto (docker, else podman), docker, podman, or off (runs wait in
# the queue). When the server itself runs in a container, give it the engine's socket and mount
# the data folder at the same path as on the host: run containers mount files from it.
#AFS_CONTAINER_ENGINE=auto

# The execution environment image a run uses unless its launch configuration names one.
#AFS_EE_IMAGE=ghcr.io/ansible/community-ansible-dev-tools:latest

# A run that takes longer is stopped (minutes).
#AFS_RUN_TIMEOUT_MINUTES=240

# How long ended runs are kept: removed after this many days, and beyond this many of one flow.
#AFS_RUNS_KEEP_DAYS=90
#AFS_RUNS_KEEP_PER_FLOW=200
# Audit entries older than this many days are removed; 0 keeps them all.
#AFS_AUDIT_KEEP_DAYS=365
# Notifications sent or given up on (the delivery log) are kept this many days.
#AFS_NOTIFICATIONS_KEEP_DAYS=30

# How many runs at once: on this server, and of one project (two runs on the same devices at
# once is rarely meant). A run over the limit waits in the queue.
#AFS_MAX_RUNS=4
#AFS_MAX_RUNS_PER_PROJECT=1

# Allow a project's repository to be a folder of this machine (a single-machine install, tests).
#AFS_GIT_LOCAL=on

# Where the server keeps what it owns (the SQLite database; later repositories and runs).
AFS_DATA_DIR=data

# The database. Default: SQLite, the file afs.db in the data folder.
#   sqlite:flows.db                                      a file in the data folder
#   sqlite:/var/lib/flow-server/afs.db                   a file anywhere
#   postgres://flows:CHANGE_ME@db.example.net:5432/flows PostgreSQL
#AFS_DATABASE_URL=sqlite:afs.db

# The log: trace, debug, info, warn, error, fatal or silent; as text or json (one object a line).
AFS_LOG_LEVEL=info
AFS_LOG_FORMAT=text
