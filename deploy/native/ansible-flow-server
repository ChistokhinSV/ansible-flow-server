#!/bin/sh
# The server's command line (AFS-36): `ansible-flow-server user add dana --admin`, `cert show`,
# `secrets status`... It runs as the service user, with the service's settings, so what it
# changes is the server's own data. Installed by install.sh as /usr/local/bin/ansible-flow-server.
set -eu
PREFIX=@PREFIX@
USER_NAME=@USER@
ENV_FILE=/etc/ansible-flow-server/afs.env

if [ "$(id -un)" = "$USER_NAME" ]; then
  set -a; . "$ENV_FILE"; set +a
  cd "$AFS_DATA_DIR"
  exec "$PREFIX/current/node/bin/node" "$PREFIX/current/app/dist/server.js" "$@"
fi
if [ "$(id -u)" -ne 0 ]; then
  echo "Run it as root (sudo) or as $USER_NAME: it changes the server's data." >&2
  exit 1
fi
exec runuser -u "$USER_NAME" -- "$(readlink -f "$0")" "$@"
