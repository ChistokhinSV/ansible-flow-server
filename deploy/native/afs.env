# Ansible Flow Server settings (AFS-36), read by the service and by the ansible-flow-server
# command. Change, then: systemctl restart ansible-flow-server. Every setting of the repository's
# .env.example can go here. Values below are examples.

# The address and port to listen on (HTTPS; a self-signed certificate at first start).
AFS_HOST=0.0.0.0
AFS_PORT=8443
# The address people use. The certificate must be good for its host.
#AFS_PUBLIC_URL=https://flows.example.net:8443

# Where the server keeps its data: the SQLite database, repositories, runs, the certificate and
# the master key (master.key: keep a copy elsewhere).
AFS_DATA_DIR=@DATA@

# The engine runs use: podman (rootless, as the service user) or docker.
AFS_CONTAINER_ENGINE=@ENGINE@
# The image a run uses unless its launch configuration names one.
#AFS_EE_IMAGE=ghcr.io/ansible/community-ansible-dev-tools:latest

# PostgreSQL instead of SQLite in the data folder.
#AFS_DATABASE_URL=postgres://flows:CHANGE_ME@db.example.net:5432/flows

AFS_LOG_LEVEL=info
AFS_LOG_FORMAT=text
