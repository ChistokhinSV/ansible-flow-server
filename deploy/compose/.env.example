# Ansible Flow Server with docker compose: copy to .env beside compose.yaml and change what you
# need. Compose reads it for the file's own values, and the server gets every line (so any AFS_*
# setting of the repository's .env.example can go here too). Values below are examples.

# The image and its version (a release tag such as 1.0.0, or latest).
#AFS_IMAGE=ghcr.io/chistokhinsv/ansible-flow-server
#AFS_IMAGE=docker.io/chistokhinsv/ansible-flow-server
AFS_VERSION=latest

# The port of this machine people open (HTTPS; a self-signed certificate at first start).
AFS_PUBLISH_PORT=8443
# The address people use. The certificate must be good for its host.
AFS_PUBLIC_URL=https://flows.example.net:8443

# The engine's socket on this machine. Rootless docker: /run/user/1000/docker.sock.
#AFS_ENGINE_SOCKET=/var/run/docker.sock
# Where the data volume is on the engine's machine, only when the server cannot find it out
# itself (it asks the engine about its own container at start).
#AFS_ENGINE_DATA_DIR=/var/lib/docker/volumes/ansible-flow-server_afs-data/_data

# The image a run uses unless its launch configuration names one.
#AFS_EE_IMAGE=ghcr.io/ansible/community-ansible-dev-tools:latest

# The master key credentials are sealed with. Unset: made in the data volume at first start
# (master.key); keep a copy outside it. Make one with: openssl rand -base64 32
#AFS_MASTER_KEY=

# PostgreSQL (docker compose --profile postgres up -d): its password, and the server's address
# for it. Leave both out for SQLite in the data volume.
#AFS_DB_PASSWORD=CHANGE-ME-long-random
#AFS_DATABASE_URL=postgres://afs:${AFS_DB_PASSWORD}@postgres:5432/afs

AFS_LOG_LEVEL=info
AFS_LOG_FORMAT=text
